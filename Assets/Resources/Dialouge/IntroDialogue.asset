%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 820d416301b7d80479b71d4478693782, type: 3}
  m_Name: IntroDialogue
  m_EditorClassIdentifier: 
  sentences:
  - "\uC548\uB155\uD558\uC138\uC694! \uC6B4\uB3D9\uC744\uD558\uB7EC \uC624\uC168\uB098\uC694?"
  - "\uADF8\uB7F0\uB370 \uC5B4\uB5BB\uAC8C \uC6B4\uB3D9\uC744 \uD574\uC57C\uD558\uB294\uC9C0
    \uBAA8\uB974\uACA0\uB2E4\uACE0\uC694?"
  - "\uAC71\uC815\uB9C8\uC138\uC694 \uC81C\uAC00 \uD558\uB098\uC529 \uAC00\uB974\uCCD0\uB4DC\uB9B4\uAC8C\uC694."
  - "\uC6B0\uC120 \uC774 \uD654\uBA74\uC740 \uAC00\uC9C0\uACE0\uC788\uB294 \uBB3C\uAC74\uB4E4\uC744
    \uBCF4\uAD00\uD558\uB294 \uC7A5\uC18C\uC5D0\uC694"
  - "\uB2E4\uC74C\uC744 \uD1B5\uD574\uC11C \uCE90\uB9AD\uD130\uB97C \uBCC0\uACBD\uD560
    \uC218 \uC788\uC5B4\uC694, \uCE90\uB9AD\uD130\uB294 100\uB808\uBCA8\uC774 \uB420\uB54C\uB9C8\uB2E4
    \uC0C8\uB85C\uC6B4 \uCE90\uB9AD\uD130\uB85C \uC6B4\uB3D9\uD560 \uC218 \uC788\uC5B4\uC694"
  - "\uD604\uC7AC \uCC29\uC6A9\uC911\uC778 \uC544\uC774\uD15C\uC744 \uD655\uC778\uD560\uC218
    \uC788\uC5B4\uC694, \uCD5C\uB300 3\uAC1C\uAE4C\uC9C0 \uC7A5\uBE44 \uAC00\uB2A5\uD574\uC694"
  - "\uCC29\uC6A9\uD55C \uC544\uC774\uD15C\uC740 \uD074\uB9AD\uC2DC \uB2E4\uC2DC
    \uD574\uCCB4\uD560 \uC218 \uC788\uC5B4\uC694."
  - "\uD604\uC7AC \uCC29\uC6A9\uD55C \uC544\uC774\uD15C\uC758 \uD6A8\uACFC\uB97C
    \uBCFC \uC218 \uC788\uC5B4\uC694."
  - "\uC544\uB798\uB294 \uD604\uC7AC \uAC00\uC9C0\uACE0 \uC788\uB294 \uBAA8\uB4E0
    \uC544\uC774\uD15C\uB4E4\uC744 \uBCFC \uC218 \uC788\uC5B4\uC694."
  - "\uB2E4\uC74C \uD654\uBA74\uC740 \uB808\uBCA8\uC5C5 \uD654\uBA74\uC774\uC5D0\uC694.
    \uC704\uC5D0\uC11C\uB294 \uCE90\uB9AD\uD130\uAC00 \uC6B4\uB3D9\uD558\uB294 \uBAA8\uC2B5\uC744
    \uBCFC \uC218 \uC788\uC5B4\uC694."
  - "\uD574\uB2F9 \uBD80\uBD84\uC73C\uB85C \uC6B4\uB3D9 \uACBD\uD5D8\uCE58\uB97C
    \uB4DC\uB798\uADF8\uD558\uAC70\uB098 \uC544\uB798 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74
    \uBAA8\uB4E0 \uACBD\uD5D8\uCE58\uB97C \uD68D\uB4DD\uD560\uC218 \uC788\uC5B4\uC694."
  - "\uD604\uC7AC \uC6B4\uB3D9 \uBD80\uC704\uB4E4\uC758 \uB808\uBCA8\uC744 \uD655\uC778
    \uAC00\uB2A5\uD574\uC694."
  - "\uC6B4\uB3D9\uC744 \uD1B5\uD574 \uC5BB\uC740 \uACBD\uD5D8\uCE58\uB294 \uB2E4\uC74C\uACFC
    \uAC19\uC774 \uBAA8\uC774\uACE0 \uAC19\uC740 \uC0C9\uC758 \uACBD\uD5D8\uCE58\uB4E4\uC744
    \uD569\uCE58\uBA74 \uB354 \uB192\uC740 \uACBD\uD5D8\uCE58\uB97C \uD68D\uB4DD
    \uAC00\uB2A5\uD574\uC694."
  - "\uACBD\uD5D8\uCE58\uB294 \uD30C\uB791\uC0C9, \uCD08\uB85D\uC0C9, \uB178\uB791\uC0C9,
    \uBE68\uAC15\uC0C9 \uC21C\uC11C\uB85C \uB192\uC544\uC694."
  - "\uB2E4\uC74C\uC740 \uC6B4\uB3D9 \uD654\uBA74\uC774\uC5D0\uC694. \uC9C1\uC811
    \uC6B4\uB3D9\uB8E8\uD2F4\uC744 \uB9CC\uB4E4\uC5B4\uBCFC \uC218 \uC788\uC5B4\uC694."
  - "\uC5D0\uB108\uC9C0\uAC00 \uC5C6\uB294 \uACBD\uC6B0 \uC6B4\uB3D9\uC744 \uD560
    \uC218 \uC5C6\uACE0, \uBC24\uC774\uB418\uAC70\uB098 \uC544\uC774\uD15C\uC744
    \uD1B5\uD574 \uD68C\uBCF5\uC774 \uAC00\uB2A5\uD574\uC694."
  - "\uD53C\uB85C\uB3C4\uC758 \uACBD\uC6B0 \uB192\uC544\uC9C8 \uC218\uB85D \uB192\uC740
    \uB808\uBCA8\uC758 \uACBD\uD5D8\uCE58\uB97C \uC5BB\uAE30 \uD798\uB4E4\uACE0,
    \uB9C8\uCC2C\uAC00\uC9C0\uB85C \uBC24\uC774\uB418\uAC70\uB098 \uC544\uC774\uD15C\uC744
    \uD1B5\uD574 \uD68C\uBCF5\uC774 \uAC00\uB2A5\uD574\uC694."
  - "\uC9C0\uAE08\uAE4C\uC9C0 \uCD1D \uC6B4\uB3D9\uD55C \uB0A0\uC744 \uC54C \uC218
    \uC788\uC5B4\uC694."
  - "\uD604\uC7AC \uC120\uD0DD\uD55C \uC6B4\uB3D9 \uB8E8\uD2F4\uC744 \uBCFC \uC218
    \uC788\uC5B4\uC694."
  - "\uC6B4\uB3D9 \uB8E8\uD2F4\uC744 \uACE0\uC815\uD574 \uC720\uC9C0\uD560 \uC218
    \uC788\uC5B4\uC694."
  - "\uC624\uB298 \uC6B4\uB3D9\uD560 \uBD80\uC704\uB97C \uC120\uD0DD\uD560 \uC218
    \uC788\uC5B4\uC694."
  - "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC0C1\uC810\uC774\uC5D0\uC694."
  - "\uAD11\uACE0\uB97C \uBCF4\uACE0 30\uCD08\uAC04 \uC9C4\uD589\uC2DC\uAC04\uC744
    \uBE60\uB974\uAC8C \uD574\uC918\uC694."
  - "\uB808\uBCA8\uC5C5\uC744 5\uD68C\uD560\uB54C\uB9C8\uB2E4 \uC0C8\uB85C\uC6B4
    \uC544\uC774\uD15C\uC744 \uC5BB\uC744 \uC218 \uC788\uC5B4\uC694."
  - "\uC544\uC774\uD15C\uC758 \uACBD\uC6B0 \uD50C\uB808\uC774\uC5B4\uAC00 \uAC00\uC9C0\uACE0
    \uC788\uB294 \uD574\uB2F9 \uBD80\uC704\uC758 \uB808\uBCA8\uB85C \uAD6C\uB9E4
    \uAC00\uB2A5\uD558\uACE0 1\uC2DC\uAC04\uB9C8\uB2E4 \uC0C8\uB86D\uAC8C \uBCC0\uACBD\uAC00\uB2A5\uD574\uC694"
  - "\uC774\uC81C \uBAA8\uB4E0 \uAD6C\uC5ED\uC744 \uC124\uBA85\uB4E4\uC5C8\uC73C\uB2C8
    \uC6B4\uB3D9\uC744 \uD558\uB7EC \uAC00\uBCFC\uAE4C\uC694?"
